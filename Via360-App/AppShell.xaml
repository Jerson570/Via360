<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Via360.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Via360.App"
    xmlns:pages="clr-namespace:Via360.App.Pages"
    xmlns:autoridad="clr-namespace:Via360.App.Pages.Autoridad"
    x:Name="self"
    Title="via360"
    FlyoutBackgroundColor="White"
    FlyoutHeaderBehavior="Default"
    FlyoutVerticalScrollMode="Disabled">

    <ShellContent
        Title="via360"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"/>

    <!-- Registro -->
    <ShellContent
        ContentTemplate="{DataTemplate local:RegistroPage}"
        Route="RegistroPage"/>

    <!-- Recuperar contraseña -->
    <ShellContent
        ContentTemplate="{DataTemplate local:RecuperarPage}"
        Route="RecuperarPage"/>

    <!-- Pantalla principal ciudadano -->
    <ShellContent
        ContentTemplate="{DataTemplate pages:PantallaPrincipal}"
        Route="PantallaPrincipal"/>

        <!-- Pantalla principal autoridad -->
    <ShellContent 
        ContentTemplate="{DataTemplate autoridad:AutoridadPage}"
        Route="AutoridadPage"/>
    
   

    <Shell.FlyoutHeader>
        <Grid HeightRequest="90" BackgroundColor="White">
            <Label Text="Via360"
                   TextColor="#512BD4"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,20,0,0"/>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ESTO EMPUJA EL CONTENIDO HACIA ARRIBA -->
    <Shell.FlyoutContent>
        <CollectionView BindingContext="{x:Reference self}" />
    </Shell.FlyoutContent>

    <!-- BOTÓN DE CERRAR SESIÓN EN EL PIE DE PÁGINA (Abajo) -->
    <Shell.FlyoutFooter>
        <StackLayout Padding="20">
            <Button Text="Cerrar Sesión"
                    Command="{Binding LogoutCommand}"
                    TextColor="White"
                    BackgroundColor="#512BD4"
                    CornerRadius="15"
                    HeightRequest="50"
                    Margin="0,0,0,20"/>
        </StackLayout>
    </Shell.FlyoutFooter>

</Shell>
