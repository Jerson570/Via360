<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Via360.App.Pages.PerfilPage"
             BackgroundColor="#FBFBFF"
             Shell.TitleColor="White"
             Shell.BackgroundColor="#512BD4"
             Title="Mi Perfil">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25" Spacing="25">
                <!-- Identidad Dinámica -->
                <VerticalStackLayout Spacing="5" Margin="0,10,0,10">
                    <Label Text="BIENVENIDO" FontSize="17" CharacterSpacing="2" TextColor="#512BD4" FontAttributes="Bold"/>
                    <Label x:Name="LblNombreUsuario" Text="..." FontSize="32" FontAttributes="Bold" TextColor="Black"/>
                </VerticalStackLayout>

                <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="25">
                        <!-- Campo Dinámico Correo -->
                        <Grid ColumnDefinitions="40, *">
                            <Label Grid.Column="0" Text="✉" FontSize="20" VerticalOptions="Center" TextColor="#512BD4"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Correo Electrónico" FontSize="11" TextColor="Gray"/>
                                <Label x:Name="LblCorreoUsuario" Text="..." FontSize="16" TextColor="Black"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Campo Dinámico de fecha -->
                        <Grid ColumnDefinitions="40, *">
                            <Label Grid.Column="0" Text="📅" FontSize="20" VerticalOptions="Center" TextColor="#512BD4"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Miembro desde" FontSize="11" TextColor="Gray"/>
                                <Label x:Name="LblFechaRegistro" Text="..." FontSize="16" TextColor="Black"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            <Button Text="Cerrar Sesión" TextColor="#FF3B30" BackgroundColor="#1AFF3B30" 
                        FontSize="15" FontAttributes="Bold" Margin="0,40,0,0" Clicked="OnCerrarSesionClicked"/>
            </VerticalStackLayout>
        </ScrollView>
    
</ContentPage>