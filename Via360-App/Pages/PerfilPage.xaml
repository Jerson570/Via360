<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Via360.App.Pages.PerfilPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             Title="PerfilPage">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">

            <!-- Avatar / Foto de Perfil -->
            <VerticalStackLayout HorizontalOptions="Center" Margin="0,20,0,10">
                <Border Stroke="#512BD4"
                        StrokeThickness="2"
                        HeightRequest="100"
                        WidthRequest="100"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="50"/>
                    </Border.StrokeShape>
                    <Grid BackgroundColor="#F0F0F0">
                        <Label Text="👤" 
                               FontSize="50" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>
                <Label x:Name="LblNombreUsuario" 
                       Text="Nombre de Usuario" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       Margin="0,15,0,0"
                       TextColor="Black"/>
                <Label x:Name="LblCorreoUsuario" 
                       Text="usuario@correo.com" 
                       FontSize="14" 
                       TextColor="Gray" 
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" Margin="0,10"/>

            <!-- Información Detallada -->
            <VerticalStackLayout Spacing="15">
                <Label Text="Información de la cuenta" FontSize="16" FontAttributes="Bold" TextColor="#512BD4"/>

                <!-- Tarjeta de Info -->
                <Border Stroke="#F0F0F0" Padding="15" StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="📅" VerticalOptions="Center"/>
                            <Label Text="Miembro desde: Mayo 2026" VerticalOptions="Center" TextColor="#444"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="📍" VerticalOptions="Center"/>
                            <Label Text="Ubicación: Medellín, Colombia" VerticalOptions="Center" TextColor="#444"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Botones de Acción -->
            <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="Editar Perfil" 
                        BackgroundColor="White" 
                        TextColor="#512BD4" 
                        BorderColor="#512BD4" 
                        BorderWidth="1"
                        CornerRadius="25"
                        HeightRequest="50"/>

                <Button Text="Cerrar Sesión" 
                        BackgroundColor="#FFEBEB" 
                        TextColor="#FF3B30" 
                        CornerRadius="25"
                        HeightRequest="50"
                        Clicked="OnCerrarSesionClicked"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>