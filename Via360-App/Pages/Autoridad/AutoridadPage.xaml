<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Via360.App.Pages.Autoridad.AutoridadPage"
             Shell.FlyoutItemIsVisible="False"
             BackgroundColor="#F2F2F7"
             Title="AutoridadPage">
    <Grid RowDefinitions="Auto, 200, *">

        <!-- 1. BARRA SUPERIOR -->
        <Grid Grid.Row="0" HeightRequest="80" BackgroundColor="#512BD4" Padding="20,30,20,0">
            <Label Text="Panel de Control" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
        </Grid>

        <!-- 2. CUADRO DEL MAPA (Cabecera Visual) -->
        <Border Grid.Row="1" Margin="20,15" StrokeThickness="0" BackgroundColor="White">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.1"/>
            </Border.Shadow>

            <Grid>
                <!-- Aquí iría el control de Mapa real, por ahora un placeholder elegante -->
                <Image Source="map_placeholder.png" Aspect="AspectFill" Opacity="0.6"/>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="📍" FontSize="30" HorizontalOptions="Center"/>
                    <Label Text="Mapa de Reportes" FontSize="12" TextColor="#512BD4" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- 3. LISTA DE REPORTES -->
        <VerticalStackLayout Grid.Row="2" Padding="20,0,20,20" Spacing="15">
            <Label Text="Reportes Recientes" FontSize="18" FontAttributes="Bold" TextColor="Black" Margin="5,0"/>

            <CollectionView x:Name="CrvReportesAutoridad" SelectionMode="Single" SelectionChanged="OnReporteSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="15" StrokeThickness="0" BackgroundColor="White">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*, Auto">
                                <!-- Info Izquierda -->
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Titulo}" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                                    <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>

                                <!-- Estado Derecha -->
                                <Border Grid.Column="1" Padding="10,5" BackgroundColor="#1A512BD4" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Estado}" FontSize="11" TextColor="#512BD4" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>